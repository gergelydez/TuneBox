# --- Obligatoriu dacă folosești Google Drive ---
# Din Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Adresa la care deschizi aplicația (exact așa trebuie pusă și la
# "Authorized redirect URIs" în Google: APP_URL + /api/drive/callback)
APP_URL=http://localhost:3000

# Numele folderului creat în Drive
DRIVE_FOLDER_NAME=YT MP3

# --- Recomandat dacă aplicația e accesibilă din afara casei ---
# Dacă e setat, aplicația cere parolă
APP_PASSWORD=

# --- Opțional ---
# DOWNLOAD_DIR=./downloads
# DATA_DIR=./data
# YTDLP_PATH=yt-dlp
# FFMPEG_DIR=C:\ffmpeg\bin
