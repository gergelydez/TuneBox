<?xml version="1.0" encoding="utf-8"?>
<!-- Player-ul pe tot ecranul (se deschide apăsând pe player-ul mic de jos) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingBottom="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/fullClose"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="-12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Închide"
            android:src="@drawable/ic_expand_more"
            app:tint="@color/text" />

        <TextView
            android:id="@+id/fullContext"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:text="Se redă acum"
            android:textAllCaps="true"
            android:textColor="@color/muted"
            android:textSize="12sp"
            android:textStyle="bold" />

        <View
            android:layout_width="36dp"
            android:layout_height="1dp" />
    </LinearLayout>

    <!-- coperta: pătrată, cât încape -->
    <FrameLayout
        android:id="@+id/fullArtBox"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp"
        android:layout_weight="1">

        <ImageView
            android:id="@+id/fullArt"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:background="@drawable/art_big_bg"
            android:contentDescription="@null"
            android:scaleType="centerInside"
            android:src="@drawable/ic_music"
            app:tint="@color/muted" />
    </FrameLayout>

    <TextView
        android:id="@+id/fullTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="marquee"
        android:marqueeRepeatLimit="marquee_forever"
        android:singleLine="true"
        android:textColor="@color/text"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/fullSub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/muted"
        android:textSize="15sp" />

    <!-- bara de timp: o tragi ca să sari în piesă -->
    <SeekBar
        android:id="@+id/fullSeek"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="-16dp"
        android:layout_marginTop="18dp"
        android:layout_marginEnd="-16dp"
        android:maxHeight="6dp"
        android:minHeight="6dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:progressBackgroundTint="@color/muted"
        android:progressTint="@color/brand"
        android:secondaryProgressTint="@color/muted"
        android:thumbTint="@color/brand" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/fullPosition"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="0:00"
            android:textColor="@color/muted"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/fullDuration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0:00"
            android:textColor="@color/muted"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- anterioara · -10 s · play · +10 s · următoarea -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/fullPrev"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Piesa anterioară"
            android:scaleType="center"
            android:src="@drawable/ic_skip_prev"
            app:tint="@color/text" />

        <LinearLayout
            android:id="@+id/fullBack"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Înapoi 10 secunde"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_fast_rewind"
                app:tint="@color/text" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="10 s"
                android:textColor="@color/muted"
                android:textSize="10sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/fullPlay"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/round_btn"
            android:contentDescription="Redă"
            android:scaleType="center"
            android:src="@drawable/ic_play"
            app:tint="#FFFFFF" />

        <LinearLayout
            android:id="@+id/fullFwd"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Înainte 10 secunde"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_fast_forward"
                app:tint="@color/text" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="10 s"
                android:textColor="@color/muted"
                android:textSize="10sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/fullNext"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Piesa următoare"
            android:scaleType="center"
            android:src="@drawable/ic_skip_next"
            app:tint="@color/text" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/fullShuffle"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Amestecă"
            android:src="@drawable/ic_shuffle"
            app:tint="@color/muted" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/fullRepeat"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Repetă"
            android:src="@drawable/ic_repeat"
            app:tint="@color/muted" />
    </LinearLayout>
</LinearLayout>
